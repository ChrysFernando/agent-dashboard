PORT=3000
HOST=0.0.0.0
# Local dev: any reachable Postgres instance. On Vercel, the Neon/Supabase
# marketplace integration injects POSTGRES_PRISMA_URL, which env.ts uses
# automatically when DATABASE_URL is unset.
DATABASE_URL="postgresql://user:password@localhost:5432/agent_dashboard"
# NODE_ENV=production toggles secure cookies. Vercel sets this on its own.
NODE_ENV=development
DASHBOARD_HTML_PATH="./Aether AI Agent Dashboard.html"
WORKSPACE_NAME="Acme Corp"
WORKSPACE_TIMEZONE="Asia/Colombo (UTC+05:30)"
WORKSPACE_DEFAULT_LANGUAGE="English (US)"
BILLING_CURRENCY="USD"
BILLING_PLAN_NAME="Scale"
BILLING_PLAN_FEE="899.00"
BILLING_MONTHLY_BUDGET="9500.00"
BILLING_VOICE_AGENT_RATE_PER_MINUTE="0.42"
BILLING_AI_AGENT_RATE_PER_MINUTE="0.50"
BILLING_CALL_RATE_PER_MINUTE="0.08"
BILLING_WHATSAPP_MESSAGE_RATE="0.02"
BILLING_TRANSCRIPT_RATE_PER_MINUTE="0.03"
BILLING_KB_DOCUMENT_MONTHLY_RATE="2.50"
BILLING_KB_UPDATE_RATE="0.15"
ANALYTICS_REVENUE_PER_CONVERSION="249.00"
INBOUND_WEBHOOK_SECRET=""
